# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Docker & Prisma)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=quiz_db
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/quiz_db?schema=public

# Authentication Secrets & Expiration Times
JWT_ACCESS_TOKEN_SECRET=your-32-character-access-token-secret-here
JWT_REFRESH_TOKEN_SECRET=your-32-character-refresh-token-secret-here
JWT_ACCESS_TOKEN_EXPIRATION_MS=30000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000
